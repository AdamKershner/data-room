# Signs session cookies and magic links. Required. Changing it signs everyone out.
DATA_ROOM_COOKIE_SECRET=change-me-to-a-long-random-string

# Directory admins (comma-separated). These emails can approve / invite / revoke.
DATA_ROOM_ADMINS=adam@kahana.io

# Where access-request emails are delivered.
DATA_ROOM_ACCESS_TO=adam@kahana.io

# Optional break-glass password for admins if email is not set up yet.
# DATA_ROOM_PASSWORD=

# Public URL used in magic-link emails (set this on Vercel).
# DATA_ROOM_PUBLIC_URL=https://your-data-room.vercel.app

# Optional. Emails sign-in and approval links via Resend.
# RESEND_API_KEY=
# RESEND_FROM=Kahana Data Room <noreply@kahana.io>

# Optional. Persist the access directory on Vercel (Upstash / Vercel KV).
# Locally the directory is saved to data/access-store.json.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Local only: print / surface magic links when Resend is not configured.
# DATA_ROOM_DEV_LINKS=true

# Local `npm run dev` opens the data room without a Kahana hub token (default true).
# Set to false if you need to test /open-from-kahana.html on localhost.
# DATA_ROOM_LOCAL_OPEN=true

# Shared with Kahana Cloud Functions (same value as KNOWLEDGE_BASE_EMBED_JWT_SECRET).
# Required for hub-member embeds. Direct visits without a token see /open-from-kahana.html.
# KNOWLEDGE_BASE_EMBED_JWT_SECRET=
